#include<iostream>
using namespace std;
void nonrepeate(int arr[], int n)
{
for(int i=0;i<n;i++)
{
for(int j=i+1;j<n;j++)
{
if(arr[i]!==arr[j])
{
    return arr[i];
}
}
}
}
int main(){
int arr[]={1,2,3,2,1,4,5}
int size=sizeof(arr)/sizeof(arr[0]);
int result=nonrepeate(int arr[], int size);
cout<<result;
}
